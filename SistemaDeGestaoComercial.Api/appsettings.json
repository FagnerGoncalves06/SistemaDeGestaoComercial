{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=GestaoComercial;Integrated Security=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SistemaDeGestaoComercial",
    "Audience": "SistemaDeGestaoComercial.Web"
  },
  "Frontend": { "Url": "http://localhost:5173" },
  "Negocio": { "FusoHorario": "America/Sao_Paulo" },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "gestao-comercial.events",
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "RetryDelaySeconds": 15,
    "MaxRetries": 3,
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
